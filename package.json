{
  "name": "gem-cascade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gem Cascade - a mobile match-3 puzzle game (Phaser 3 + Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "balance": "vite-node scripts/balance.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
